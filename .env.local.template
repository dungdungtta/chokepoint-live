# ──────────────────────────────────────────────
# .env.local  — 로컬 개발 전용. 절대 git에 커밋하지 말 것.
# .gitignore에 이 파일이 포함되어 있는지 확인하세요.
# ──────────────────────────────────────────────

# 1. EIA Open Data (무료)
#    발급: https://www.eia.gov/opendata/
EIA_API_KEY=여기에_키_입력

# 2. NewsAPI.org (무료 100 req/일)
#    발급: https://newsapi.org/register
NEWSAPI_KEY=여기에_키_입력

# 3. FRED API (무료, St. Louis Fed)
#    발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=여기에_키_입력

# 4. Freightos (선택 — MVP 없어도 됨)
#    가입: https://fbx.freightos.com/
FREIGHTOS_API_KEY=

# 5. Workers URL (배포 후 입력)
#    형태: https://chokepoint-api.계정명.workers.dev
WORKERS_URL=
